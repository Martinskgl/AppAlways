{
    "openapi": "3.0.0",
    "info": {
        "title": "AppAlways API",
        "description": "API de Checkout - Teste Técnico AlwaysFit",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Local"
        },
        {
            "url": "/api"
        }
    ],
    "paths": {
        "/api/checkout": {
            "post": {
                "tags": [
                    "Checkout"
                ],
                "summary": "Realizar checkout",
                "operationId": "53afc384fecd22373e26d15287a176db",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "customer_id",
                                    "items",
                                    "credit_card"
                                ],
                                "properties": {
                                    "customer_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "items": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "product_id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "quantity": {
                                                    "type": "integer",
                                                    "example": 2
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "credit_card": {
                                        "properties": {
                                            "holder_name": {
                                                "type": "string",
                                                "example": "João Silva"
                                            },
                                            "number": {
                                                "type": "string",
                                                "example": "1234567890123456"
                                            },
                                            "expiry_month": {
                                                "type": "integer",
                                                "example": 12
                                            },
                                            "expiry_year": {
                                                "type": "integer",
                                                "example": 2027
                                            },
                                            "cvv": {
                                                "type": "string",
                                                "example": "123"
                                            }
                                        },
                                        "type": "object"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Pedido criado com sucesso"
                    },
                    "422": {
                        "description": "Erro de validação"
                    }
                }
            }
        },
        "/api/orders/{order_id}": {
            "get": {
                "tags": [
                    "Orders"
                ],
                "summary": "Consultar pedido",
                "operationId": "b02de67b324d267068066a6b1ad7fa71",
                "parameters": [
                    {
                        "name": "order_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Pedido encontrado"
                    },
                    "404": {
                        "description": "Pedido não encontrado"
                    }
                }
            }
        },
        "/api/webhook/payment": {
            "post": {
                "tags": [
                    "Webhook"
                ],
                "summary": "Confirmação de pagamento via webhook",
                "operationId": "e0ee9229a2d2ce105641a5f10b8c4a12",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "order_id",
                                    "status"
                                ],
                                "properties": {
                                    "order_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "approved",
                                        "enum": [
                                            "approved",
                                            "declined"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Webhook processado com sucesso"
                    },
                    "422": {
                        "description": "Erro de validação"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Checkout",
            "description": "Checkout"
        },
        {
            "name": "Orders",
            "description": "Orders"
        },
        {
            "name": "Webhook",
            "description": "Webhook"
        }
    ]
}